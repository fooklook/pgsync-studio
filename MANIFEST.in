include LICENSE AUTHORS.rst UPSTREAM.md README.md README.zh-CN.md
include CONTRIBUTING.md SECURITY.md CHANGELOG.md
include .env.example Dockerfile compose.yaml .dockerignore .gitignore
recursive-include bin *
recursive-include requirements *.txt *.in
recursive-include pgsync/web/static *.html *.css *.js *.ico
recursive-include examples *.py *.json *.sql README
recursive-include plugins *.py
recursive-include docs *.md
recursive-include tests *.py *.json
recursive-include tools *.py
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
