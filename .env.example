# Docker Compose demo only. Replace this value before starting the demo.
# The PostgreSQL password is injected separately from the connection URL.
DEMO_POSTGRES_PASSWORD=change-me-local-only

# Optional settings for running Python directly rather than Docker Compose.
PGSYNC_STUDIO_PROFILE=dev
NACOS_ENABLED=false
PGSYNC_STUDIO_HOST=127.0.0.1
PGSYNC_STUDIO_PORT=8180
PG_USER=studio
ELASTICSEARCH=true

# Shared source-database credentials; supplied at runtime, not in the UI.
# PGSYNC_STUDIO_PG_USERNAME=studio
# PGSYNC_STUDIO_PG_PASSWORD=

# Optional PostgreSQL configuration store. Omit for local JSON storage.
# PGSYNC_STUDIO_CONFIG_DATABASE_URL=postgresql+psycopg2://studio@localhost:5432/studio
# PGSYNC_STUDIO_CONFIG_DATABASE_USERNAME=studio
# PGSYNC_STUDIO_CONFIG_DATABASE_PASSWORD=

# Optional batch-scoped replica reads. Trigger/outbox writes stay on primary.
PGSYNC_STUDIO_READ_REPLICA_ENABLED=false
# PGSYNC_STUDIO_READ_REPLICA_HOST=replica.example.com
# PGSYNC_STUDIO_READ_REPLICA_PORT=5432
# PGSYNC_STUDIO_READ_REPLICA_WAIT_TIMEOUT_MS=2000
# PGSYNC_STUDIO_READ_REPLICA_POLL_INTERVAL_MS=100
# PGSYNC_STUDIO_READ_REPLICA_FALLBACK_TO_PRIMARY=true
# PGSYNC_STUDIO_READ_REPLICA_COOLDOWN_MS=30000

# Destructive maintenance remains disabled until configured explicitly.
PGSYNC_STUDIO_DURABLE_OUTBOX_CLEANUP_ENABLED=false
PGSYNC_STUDIO_DURABLE_OUTBOX_PARTITION_MAINTENANCE_ENABLED=false
